jdl 1

app Demo {
  pkg com.example.demo
  java 26
  platform plain
  build maven
  storage none
}

cap csv
cap json
cap sqlite
cap testkit
cap format

// written by jails new; yours to edit or delete
dep org.assertj:assertj-core @version("3.27.7") @scope(test)
dep org.jspecify:jspecify @version("1.0.0")
dep org.junit.jupiter:junit-jupiter @version("6.1.2") @scope(test)

enum MatchOutcome {
  MATCHED
  AMOUNT_DIFFERS
  DATE_DIFFERS
  UNMATCHED
}

entity Money {
  amountMinor: long
  currency:    string @notBlank
}

entity Entry {
  reference: string @notBlank
  postedAt:  date
  amount:    Money
  memo:      string?
}

entity MatchCandidate {
  sourceEntry: Entry
  targetEntry: Entry
}

component sealed LedgerError {
  variant MalformedRow
  variant UnknownCurrency
  variant DuplicateReference
}

component strategy MatchRule {
  on match_candidate
  yields match_outcome
  variant ExactReference
  variant AmountAndDate
  variant FuzzyMemo
}

component cli Ledger {}

component command Reconcile {
  on ledger
}
