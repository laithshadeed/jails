#!/bin/sh
# jails pre-push: the one gate, and nothing else.
#
# simplify-sol.md G0: *pre-push and CI invoke only that command.* This used to
# run `cargo build && cargo test` of its own -- no `--workspace`, so it tested
# the root package alone, and no JAILS_REQUIRE_TOOLCHAIN, so a test that could
# not find its toolchain skipped and counted as a pass. Two traps CLAUDE.md
# names, both of which this hook had.
#
# Bypass with: git push --no-verify
set -e

if ! command -v mise >/dev/null 2>&1; then
    echo "pre-push: mise is not on PATH, so the verification gate cannot run."
    echo "  Pushing unverified is worse than not pushing: the gate is what"
    echo "  turns a self-skipping test into a failure."
    echo "  fix: install mise (https://mise.jdx.dev), or push with --no-verify"
    exit 1
fi

exec mise run verify-rewrite
