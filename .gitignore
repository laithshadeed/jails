/target

# Build output wherever it lands. `/target` alone is root-anchored, so a
# `target/` inside a golden fixture tree was untracked-but-not-ignored and one
# `git add -A` away from being committed.
target/

# Untracked research trees, each its own upstream repo. `CLAUDE.md` already
# describes them as gitignored; the file did not agree, and `git add -A`
# duly staged 138 embedded repositories.
/deps/
/ideas/
/patterns/

# `jails new` serialises on `<parent>/.jails-new.lock`. It holds the pid of
# whichever run last held it, so a committed one is noise that changes on every
# regeneration of the playground and means nothing to a clone.
.jails-new.lock

# Reference checkouts cloned for study, each its own upstream repo.
/minicom-public/
/minicom/

# Machine-generated audit notes. `refactor.md` was deliberately deleted in
# "Remove superseded audit and refactor notes" and keeps being regenerated on
# this checkout; committing it again resurrects a document nobody reads and
# whose section numbers nothing resolves against.
/refactor.md
