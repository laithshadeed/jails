jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Person {
  use scaffold

  id:        uuid @pk
  email:     string @notBlank @unique
  createdAt: instant @default(now())

  command RegisterPerson(email) {
    conflict on [email]
  }
}
