jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Topic {
  use scaffold

  id:      long @pk
  userId:  long
  subject: string @notBlank
  version: long @version

  transition SetTopicSubject(user_id, subject, version) {
    select [user_id]
    update [subject]
    if-match required
    route PATCH "/admin_api/topics/{userId}/subject"
  }
}
