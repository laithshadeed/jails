jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Topic @id(ent_topic) {
  use scaffold

  id: long @id(fld_topic_id) @pk
  userId: long @id(fld_topic_user_id)
  subject: string @id(fld_topic_subject) @notBlank
  version: long @id(fld_topic_version) @version
  transition SetTopicSubject(user_id, subject) @id(op_set_topic_subject) {
    select [user_id]
    update [subject]
    route PATCH "/admin_api/topics/{userId}/subject"
  }
}
