jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Owner {
  use scaffold

  id:        uuid @pk
  email:     string @notBlank @unique
  createdAt: instant @default(now())
}

entity Item {
  use scaffold

  id:        uuid @pk
  ownerId:   uuid @index
  name:      string @notBlank
  createdAt: instant @default(now())

  query ItemsByOwnerEmail(owner.email) {
    order by [created_at desc, name]
    limit 20
    join Owner as owner on owner_id -> owner.id
  }
}
