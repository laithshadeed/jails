@baseUrl = http://localhost:8080

### Create Owner
POST {{baseUrl}}/owners
Content-Type: application/json

{
  "email": "sample-email",
  "createdAt": "2026-01-01T00:00:00Z"
}

### List Owner
GET {{baseUrl}}/owners
Accept: application/json

@id = 00000000-0000-0000-0000-000000000001

### Get Owner
GET {{baseUrl}}/owners/{{id}}
Accept: application/json

### Delete Owner
DELETE {{baseUrl}}/owners/{{id}}
