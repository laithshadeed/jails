jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Ticket {
  use scaffold

  id:      long @pk
  subject: string @notBlank
  status:  string?

  query OpenTickets(status?) {
    route GET "/admin_api/tickets" consumes form
  }
}
