jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage none
}

entity Payout @id(ent_payout) {
  use dto
  id: uuid @id(fld_payout_id)
  amount: long @id(fld_payout_amount)
}

component client Ledger @id(cmp_client_ledger) {
  route GET "/ledgers"
}

component job Reconcile @id(cmp_job_reconcile) {}
