jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Article @id(ent_article) {
  use scaffold
  use search(fields: [title, body])

  id: uuid @id(fld_article_id) @pk
  title: string @id(fld_article_title) @notBlank
  body: string @id(fld_article_body)
}
