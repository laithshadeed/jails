jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Note @id(ent_note) {
  use scaffold

  id: long @id(fld_note_id) @pk
  body: string @id(fld_note_body) @notBlank
  seen: boolean @id(fld_note_seen)
  version: long @id(fld_note_version) @version
  transition MarkSeen(id, version) @id(op_mark_seen) {
    select [id]
    if-match optional
    set seen = true
    route PUT "/customer_api/seen" consumes form
  }
}
