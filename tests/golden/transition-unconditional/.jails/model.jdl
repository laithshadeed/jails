jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Note {
  use scaffold

  id:      long @pk
  body:    string @notBlank
  seen:    boolean
  version: long @version

  transition MarkSeen(id, version) {
    select [id]
    if-match optional
    set seen = true
    route PUT "/customer_api/seen" consumes form
  }
}
