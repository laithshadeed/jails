jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

enum SenderType {
  CUSTOMER
  ADMIN
}

entity Note {
  use scaffold

  id:         long @pk
  authorId:   long
  body:       string @notBlank
  senderType: SenderType

  command PostAdminNote(author_id, body) {
    set sender_type = "ADMIN"
    route POST "/admin_api/notes" consumes form
  }
}
