jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

enum SenderType @id(ent_sender_type) {
  CUSTOMER
  ADMIN
}

entity Note @id(ent_note) {
  use scaffold

  id: long @id(fld_note_id) @pk
  authorId: long @id(fld_note_author_id)
  body: string @id(fld_note_body) @notBlank
  senderType: SenderType @id(fld_note_sender_type)
  command PostAdminNote(author_id, body) @id(op_post_admin_note) {
    set sender_type = "ADMIN"
    route POST "/admin_api/notes" consumes form
  }
}
