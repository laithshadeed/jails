jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage none
}

enum PayoutStatus {
  PENDING
  SETTLED
  FAILED
}

entity Payout {
  use scaffold

  id:        uuid @pk
  amount:    long @positive
  status:    PayoutStatus @index
  version:   long @version @nonnegative
  createdAt: instant @default(now())

  command RequestPayout(id, amount) {
  }
  query PayoutsByStatus(status) {
  }
  transition ChangePayoutStatus(id, status, version) {
    select [id]
    update [status]
    if-match required
  }
}
