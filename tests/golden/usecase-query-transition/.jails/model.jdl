jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage none
}

enum PayoutStatus @id(ent_payout_status) {
  PENDING
  SETTLED
  FAILED
}

entity Payout @id(ent_payout) {
  use scaffold

  id: uuid @id(fld_payout_id) @pk
  amount: long @id(fld_payout_amount) @positive
  status: PayoutStatus @id(fld_payout_status) @index
  version: long @id(fld_payout_version) @version @nonnegative
  createdAt: instant @id(fld_payout_created_at) @default(now())
  command RequestPayout(id, amount) @id(op_request_payout) {
  }
  query PayoutsByStatus(status) @id(op_payouts_by_status) {
  }
  transition ChangePayoutStatus(id, status, version) @id(op_change_payout_status) {
    select [id]
    update [status]
    if-match required
  }
}
