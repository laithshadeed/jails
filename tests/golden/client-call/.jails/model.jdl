jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage none
}

entity ChatRequest {
  model:  string @notBlank
  prompt: string @notBlank
}

entity ChatReply {
  id:   string @notBlank
  text: string @notBlank
}

component client OpenAiChat {
  on chat_request
  yields chat_reply
  route POST "/v1/chat/completions"
}
