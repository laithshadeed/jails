jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage none
}

entity ChatRequest @id(ent_chat_request) {
  model: string @id(fld_chat_request_model) @notBlank
  prompt: string @id(fld_chat_request_prompt) @notBlank
}

entity ChatReply @id(ent_chat_reply) {
  id: string @id(fld_chat_reply_id) @notBlank
  text: string @id(fld_chat_reply_text) @notBlank
}

component client OpenAiChat @id(cmp_client_open_ai_chat) {
  on chat_request
  yields chat_reply
  route POST "/v1/chat/completions"
}
