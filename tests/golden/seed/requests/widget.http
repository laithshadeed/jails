@baseUrl = http://localhost:8080

### Create Widget
POST {{baseUrl}}/widgets
Content-Type: application/json

{
  "name": "sample-name"
}

### List Widget
GET {{baseUrl}}/widgets
Accept: application/json

@id = 00000000-0000-0000-0000-000000000001

### Get Widget
GET {{baseUrl}}/widgets/{{id}}
Accept: application/json

### Delete Widget
DELETE {{baseUrl}}/widgets/{{id}}
