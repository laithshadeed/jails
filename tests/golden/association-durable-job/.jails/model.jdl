jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

cap json

entity Owner {
  use scaffold

  id:        uuid @pk
  name:      string @notBlank
  createdAt: instant @default(now())
}

entity Item {
  use scaffold

  id:        uuid @pk
  ownerId:   uuid @index
  name:      string @notBlank
  createdAt: instant @default(now())

  relation itemOwner to Owner {
    map ownerId -> id
  }

  command AddItem(id, owner_id, name) {
  }
}

component durable-job ItemDispatcher(id: uuid, ownerId: uuid, name: string @notBlank) {
  on add_item
  yields item
}
