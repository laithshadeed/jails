@baseUrl = http://localhost:8080

### Create Owner
POST {{baseUrl}}/owners
Content-Type: application/json

{
  "name": "sample"
}

### List Owner
GET {{baseUrl}}/owners
Accept: application/json

@id = 00000000-0000-0000-0000-000000000001

### Get Owner
GET {{baseUrl}}/owners/{{id}}
Accept: application/json

### Delete Owner
DELETE {{baseUrl}}/owners/{{id}}
