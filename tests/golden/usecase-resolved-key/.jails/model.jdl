jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

enum SenderType {
  CUSTOMER
  ADMIN
}

entity Author {
  use scaffold

  id:    long @pk
  email: string @notBlank @unique
}

entity Note {
  use scaffold

  id:         long @pk
  authorId:   long @index
  body:       string @notBlank
  senderType: SenderType

  command PostNote(Author.email as email, body) {
    resolve author_id from Author.id where Author.email = email
    set sender_type = "CUSTOMER"
    route POST "/customer_api/notes" consumes form
  }
}
