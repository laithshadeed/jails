@baseUrl = http://localhost:8080

### Create Author
POST {{baseUrl}}/authors
Content-Type: application/json

{
  "email": "sample"
}

### List Author
GET {{baseUrl}}/authors
Accept: application/json

@id = 1

### Get Author
GET {{baseUrl}}/authors/{{id}}
Accept: application/json

### Delete Author
DELETE {{baseUrl}}/authors/{{id}}
