jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

entity Ticket @id(ent_ticket) {
  use scaffold

  id: long @id(fld_ticket_id) @pk
  subject: string @id(fld_ticket_subject) @notBlank
  command OpenTicket(subject) @id(op_open_ticket) {
    route POST "/customer_api/open" consumes form
  }
}
