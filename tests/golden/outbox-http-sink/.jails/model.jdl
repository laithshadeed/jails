jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

cap json @id(cap_json)

cap kafka @id(cap_kafka)

entity Message @id(ent_message) {
  use scaffold

  id: uuid @id(fld_message_id) @pk
  body: string @id(fld_message_body) @notBlank
  createdAt: instant @id(fld_message_created_at) @default(now())
  event MessageReceived(id: uuid, message_id: uuid, occurred_at: instant) @id(op_message_received) {
  }
  command ReceiveMessage(id, body) @id(op_receive_message) {
    emit message_received
    deliver outbox
  }
}

component http-sink Provider @id(cmp_http_sink_provider) {
  on receive_message
  yields message_received
}
