jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform spring
  build maven
  storage postgres
}

cap json

cap kafka

entity Message {
  use scaffold

  id:        uuid @pk
  body:      string @notBlank
  createdAt: instant @default(now())

  event MessageReceived(id: uuid, message_id: uuid, occurred_at: instant) {
  }
  command ReceiveMessage(id, body) {
    emit message_received
    deliver outbox
  }
}

component http-sink Provider {
  on receive_message
  yields message_received
}
