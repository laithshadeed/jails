jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform plain
  build maven
  storage none
}

entity Transaction @id(ent_transaction) {
  id: uuid @id(fld_transaction_id)
  amount: long @id(fld_transaction_amount)
}

entity Reward @id(ent_reward) {
  id: uuid @id(fld_reward_id)
  amount: long @id(fld_reward_amount)
}

component strategy RewardRule @id(cmp_strategy_reward_rule) {
  on transaction
  yields reward
  variant Coffee @id(var_cmp_strategy_reward_rule_coffee)
  variant Large @id(var_cmp_strategy_reward_rule_large)
}

component strategy Eligibility @id(cmp_strategy_eligibility) {
  on transaction
  variant Domestic @id(var_cmp_strategy_eligibility_domestic)
}
