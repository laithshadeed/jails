jdl 1
app Demo @id(project_demo) {
  pkg com.example.demo
  java 26
  platform plain
  build maven
  storage none
}

entity Transaction {
  id:     uuid
  amount: long
}

entity Reward {
  id:     uuid
  amount: long
}

component strategy RewardRule {
  on transaction
  yields reward
  variant Coffee
  variant Large
}

component strategy Eligibility {
  on transaction
  variant Domestic
}
